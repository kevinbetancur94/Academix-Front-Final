# Copia este archivo como ".env" para cambiar la configuración local.
# (el archivo .env NO se sube a Git; este .env.example SÍ)

# URL base del backend.
#   Backend en tu PC:     http://localhost:8080/api
#   Backend en Render:    https://proyecto-academix.onrender.com/api
VITE_API_URL=https://proyecto-academix.onrender.com/api

# true  = usar datos de ejemplo (src/data), sin backend
# false = hacer las peticiones reales a VITE_API_URL
VITE_USAR_MOCK=false
