# Copia este archivo como ".env" para cambiar la configuración local.
# (el archivo .env NO se sube a Git; este .env.example SÍ)

# URL base del backend. Para pasar a producción solo se cambia esta línea.
VITE_API_URL=http://localhost:3000/api

# true  = usar datos de ejemplo (src/data) porque todavía no hay backend
# false = hacer las peticiones reales a VITE_API_URL
VITE_USAR_MOCK=true
